# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Runtime / debug artifacts (never tracked)
debug_captures/
config.json
*.log
*.tmp

# Heavy model binaries (>1MB) fetched via scripts/download_models.py
models/tessdata_best/*.traineddata
models/tessdata_fast/eng.traineddata
models/paddleocr_latin/*.onnx

# OS artifacts
Thumbs.db
Desktop.ini
.DS_Store
# GitHub-safe local/private artifacts
.env
.env.*
**/cache/
**/data/
**/datasets/
**/debug_captures/
*.log
*.tmp
